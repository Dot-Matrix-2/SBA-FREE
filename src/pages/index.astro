---
import Layout from '../layouts/Layout.astro';
import { topics } from '../lib/topics';
---

<Layout title="Free SBA Info">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Free guide for U.S. small business owners</p>
        <h1>Free Information About SBA 7(a) Term Loans</h1>
        <p class="lede">
          Free SBA Info is a free-to-use website for small business owners. We created it to help you
          understand whether your business may qualify for an SBA 7(a) term loan. Everything here is free,
          with no sign-up required.
        </p>
        <p class="notice">
          <strong>Please note:</strong> we are not a lender, and we are not a commercial loan broker. We do not
          make loans or negotiate loan terms. We simply provide information.
        </p>
        <p class="cta-row">
          <a class="btn big" href="/quiz/">Take the Free Eligibility Quiz</a>
          <span class="cta-note">About 3 minutes. We never ask for your name, business name, or any identifying information.</span>
        </p>
      </div>
      <aside class="facts" aria-label="SBA 7(a) at a glance">
        <h2>SBA 7(a) at a glance</h2>
        <dl>
          <div><dt>Loan size</dt><dd>Up to $5 million</dd></div>
          <div><dt>Repayment</dt><dd>Up to 10 years, or 25 for real estate</dd></div>
          <div><dt>SBA guarantee</dt><dd>Up to 85% of the loan</dd></div>
          <div><dt>Used for</dt><dd>Working capital, equipment, real estate, acquisitions</dd></div>
        </dl>
        <p class="facts-note">General guide. <a href="/learn/rates-fees-and-terms/">See details</a>.</p>
      </aside>
    </div>
  </section>

  <section class="trust" aria-label="Why use this site">
    <div class="wrap trust-grid">
      <p><strong>100% free</strong> No fees, no sign-up</p>
      <p><strong>Anonymous quiz</strong> No personal information</p>
      <p><strong>No obligation</strong> Lender referral is optional</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">How it works</h2>
      <ol class="steps">
        <li class="card">
          <span class="num" aria-hidden="true">1</span>
          <h3>Learn the basics</h3>
          <p>Read plain-English guides on what a 7(a) loan is, what it costs, and how to apply.</p>
        </li>
        <li class="card">
          <span class="num" aria-hidden="true">2</span>
          <h3>Take the anonymous quiz</h3>
          <p>Answer a few questions about your business and the loan you want. No personal details are collected.</p>
        </li>
        <li class="card">
          <span class="num" aria-hidden="true">3</span>
          <h3>Decide on next steps</h3>
          <p>
            See whether you may be eligible. If you are, you can optionally ask to be referred to a reputable
            SBA lender. It is completely your choice.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2 class="section-title">Learn about SBA 7(a) loans</h2>
      <div class="cards">
        {topics.slice(0, 6).map((t) => (
          <div class="card">
            <h3>{t.title}</h3>
            <p>{t.summary}</p>
            <a class="more" href={t.href}>Read more</a>
          </div>
        ))}
      </div>
      <p><a href="/learn/">See all topics</a></p>
    </div>
  </section>
</Layout>
